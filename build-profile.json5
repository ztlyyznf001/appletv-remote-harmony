{
  // Install/select the matching SDK in DevEco Studio before building. No SDK is bundled.
  // Huawei's DevEco 26 compatibility table uses 26.0.0, not 7.0.0(26).
  "app": {
    "products": [{
      "name": "default",
      "compileSdkVersion": "26.0.0",
      "compatibleSdkVersion": "5.0.0(12)",
      "targetSdkVersion": "26.0.0",
      "runtimeOS": "HarmonyOS"
    }],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }]
  },
  "modules": [{
    "name": "entry", "srcPath": "./entry",
    "targets": [{ "name": "default", "applyToProducts": ["default"] }]
  }]
}
