// Pure pointer policy. TouchEvent timestamps are monotonic nanoseconds; geometry is vp.
// Wire timestamps are independently generated by the native authenticated session.
export class TouchContact {
  static readonly HOLD_MS: number = 500;
  static readonly MAX_MS: number = 10000;
  static readonly SLOP_VP: number = 8;
  active: boolean = false;
  pointerId: number = -1;
  x: number = 0;
  y: number = 0;
  held: boolean = false;
  private width: number = 1;
  private height: number = 1;
  private startX: number = 0;
  private startY: number = 0;
  private startedAt: number = 0;
  private lastSent: number = 0;
  private moved: boolean = false;

  begin(id: number, x: number, y: number, width: number, height: number, timestamp: number): boolean {
    if (this.active || !Number.isFinite(x) || !Number.isFinite(y) ||
      !Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0 ||
      !Number.isFinite(timestamp) || timestamp < 0) return false;
    this.active = true; this.pointerId = id; this.width = width; this.height = height;
    this.startX = x; this.startY = y; this.startedAt = timestamp; this.lastSent = timestamp;
    this.moved = false; this.held = false;
    this.update(x, y);
    return true;
  }

  update(x: number, y: number): boolean {
    if (!this.active || !Number.isFinite(x) || !Number.isFinite(y)) return false;
    const dx: number = x - this.startX;
    const dy: number = y - this.startY;
    if (dx * dx + dy * dy >= TouchContact.SLOP_VP * TouchContact.SLOP_VP) this.moved = true;
    this.x = Math.max(0, Math.min(1000, Math.floor(x / this.width * 1000)));
    this.y = Math.max(0, Math.min(1000, Math.floor(y / this.height * 1000)));
    return true;
  }

  shouldMove(timestamp: number): boolean {
    if (!this.active || !Number.isFinite(timestamp) || timestamp < this.lastSent + 16000000) return false;
    this.lastSent = timestamp;
    return true;
  }

  hold(): boolean {
    if (!this.active || this.moved || this.held) return false;
    this.held = true;
    return true;
  }

  finish(timestamp: number): boolean {
    const elapsed: number = (timestamp - this.startedAt) / 1000000;
    const tap: boolean = this.active && !this.moved && !this.held && Number.isFinite(elapsed) &&
      elapsed >= 0 && elapsed < TouchContact.HOLD_MS;
    this.reset();
    return tap;
  }

  reset(): void {
    this.active = false; this.pointerId = -1; this.held = false;
  }
}
